# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database mode:
# Set to 'true' to use the zero-dependency in-memory ACID store (no local PostgreSQL or MongoDB needed!)
# Set to 'false' if running real PostgreSQL and MongoDB instances
USE_MEMORY_DB=true

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_readiness

# Operational Event Store (MongoDB)
MONGODB_URI=mongodb://localhost:27017/student_readiness
MONGODB_DB=student_readiness

# Authentication & Security
JWT_SECRET=super-secret-development-jwt-signing-key-32chars
JWT_EXPIRY=15m
HMAC_CURSOR_SECRET=cursor-tamper-protection-hmac-key-32chars

# Frontend CORS
CORS_ORIGIN=http://localhost:5173

# Outbox Worker
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=5
