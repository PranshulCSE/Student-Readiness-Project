# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_readiness
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=student_readiness
PGHOST=localhost
PGPORT=5432

# MongoDB Connection (Append-only Event Store)
MONGODB_URI=mongodb://localhost:27017/student_readiness
MONGODB_DB=student_readiness

# Authentication & Cryptography
JWT_SECRET=super-secret-development-jwt-signing-key-32chars
JWT_EXPIRY=15m
HMAC_CURSOR_SECRET=cursor-tamper-protection-hmac-key-32chars

# CORS & Client
CORS_ORIGIN=http://localhost:5173

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRIES=5
